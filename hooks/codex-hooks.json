{
  "description": "Torre de Control: estado por sesión, notificaciones y guardas (mismo agent-event que Claude Code)",
  "hooks": {
    "SessionStart":      [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 10 }] }],
    "UserPromptSubmit":  [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 10 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 10 }] }],
    "PreToolUse":        [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/guard", "timeout": 10 }] }],
    "Stop":              [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 10 }] }],
    "Interrupt":         [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 3 }] }],
    "SubagentStart":     [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 10 }] }],
    "SubagentStop":      [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 10 }] }],
    "SessionEnd":        [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/agent-event codex", "timeout": 3 }] }]
  }
}
