#!/usr/bin/env bash
# agent-title <state-file> — generates the canonical title "project/type: description"
# for a session with Haiku (no hooks, no transcript) and applies it to airboss state,
# to Claude's session file (claude agents, statusline), and to the transcript (/resume).
# agent-event spawns it in the background the first time there is a goal.
set -u
_ab_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
for _c in "$_ab_dir/lib-airboss.sh" "$HOME/.local/bin/lib-airboss.sh"; do
  [ -r "$_c" ] && { . "$_c"; break; }
done
command -v ab_lock >/dev/null 2>&1 || { echo "airboss: lib-airboss.sh not found" >&2; exit 1; }
ab_setlocale
export AGENT_BOARD_INTERNAL=1
file="${1:-}"; [[ -f "$file" ]] || exit 0
goal=$(jq -r '.goal // empty' "$file"); project=$(jq -r '.project // "project"' "$file")
[[ -z "$goal" ]] && exit 0
CLAUDE_BIN=$(command -v claude 2>/dev/null || ls -1 "$HOME"/.local/share/mise/installs/claude/*/claude 2>/dev/null | tail -1)
[[ -x "${CLAUDE_BIN:-}" ]] || exit 0

# language for the generated description: English by default, Spanish when
# AIRBOSS_LANG (or $LANG) says es
_lang="${AIRBOSS_LANG:-${LANG%%[_.]*}}"
if [[ "$_lang" == "es" ]]; then lang_name="español"; else lang_name="English"; fi

prompt="Classify this first message from a user to a coding agent in the project \"$project\".
Reply with ONLY one line in the format \"type: description\", where type is exactly one of impl|plan|fix|review|ops|doc
(impl = implement or change code; plan = plan, design, research or evaluate; fix = fix a bug or something broken;
review = review or audit; ops = deploy, infrastructure, accounts, servers; doc = document or write)
and description is 3 to 6 words in ${lang_name}, lowercase, no quotes and no trailing period.

Message: \"\"\"${goal:0:800}\"\"\""

out=$(ab_timeout 90 "$CLAUDE_BIN" -p --model haiku --settings '{"disableAllHooks":true}' --no-session-persistence --max-turns 1 "$prompt" </dev/null 2>/dev/null | grep -E '^(impl|plan|fix|review|ops|doc):' | tail -1)
[[ "$out" =~ ^(impl|plan|fix|review|ops|doc):[[:space:]]*(.+)$ ]] || exit 0
type="${BASH_REMATCH[1]}"; desc="${BASH_REMATCH[2]}"
desc="${desc%%[.\"\']}"; desc="${desc#\"}"; desc="${desc:0:60}"

ab_lock "$file" 5 || exit 0
[[ -f "$file" ]] || { ab_unlock "$file"; exit 0; }
src=$(jq -r '.title_source // empty' "$file")
# if the user set a name meanwhile, the user wins
[[ "$src" == "name" || "$src" == "user" ]] && { ab_unlock "$file"; exit 0; }
jq --arg t "$project/$type: $desc" --arg ty "$type" \
   '.title=$t | .title_source="model" | .title_pending=0
    | .type=(if .type_source=="name" or .type_source=="user" then .type else $ty end)
    | .type_source=(if .type_source=="name" or .type_source=="user" then .type_source else "model" end)' \
   "$file" > "$file.tmp" && mv "$file.tmp" "$file"
ab_unlock "$file"
"$HOME/.local/bin/agent-event" apply-title "$file"
exit 0
