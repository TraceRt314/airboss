#!/usr/bin/env bash
# agent-title <fichero-de-estado> — genera el título canónico "proyecto/tipo: descripción"
# de una sesión con Haiku (sin hooks, sin transcript) y lo aplica al estado de la Torre,
# al fichero de sesión de Claude (claude agents, statusline) y al transcript (/resume).
# Lo lanza agent-event en segundo plano la primera vez que hay un objetivo.
set -u
export LC_ALL=C.UTF-8 AGENT_BOARD_INTERNAL=1
file="${1:-}"; [[ -f "$file" ]] || exit 0
goal=$(jq -r '.goal // empty' "$file"); project=$(jq -r '.project // "proyecto"' "$file")
[[ -z "$goal" ]] && exit 0
CLAUDE_BIN=$(command -v claude 2>/dev/null || ls -1 "$HOME"/.local/share/mise/installs/claude/*/claude 2>/dev/null | tail -1)
[[ -x "${CLAUDE_BIN:-}" ]] || exit 0

prompt="Clasifica este primer mensaje de un usuario a un agente de código en el proyecto \"$project\".
Responde SOLO una línea con el formato \"tipo: descripción\", donde tipo es exactamente uno de impl|plan|fix|review|ops|doc
(impl = implementar o cambiar código; plan = planificar, diseñar, investigar o evaluar; fix = arreglar un error o algo roto;
review = revisar o auditar; ops = desplegar, infraestructura, cuentas, servidores; doc = documentar o redactar)
y descripción son de 3 a 6 palabras en español, en minúsculas, sin comillas ni punto final.

Mensaje: \"\"\"${goal:0:800}\"\"\""

out=$(timeout 90 "$CLAUDE_BIN" -p --model haiku --settings '{"disableAllHooks":true}' --no-session-persistence --max-turns 1 "$prompt" </dev/null 2>/dev/null | grep -E '^(impl|plan|fix|review|ops|doc):' | tail -1)
[[ "$out" =~ ^(impl|plan|fix|review|ops|doc):[[:space:]]*(.+)$ ]] || exit 0
type="${BASH_REMATCH[1]}"; desc="${BASH_REMATCH[2]}"
desc="${desc%%[.\"\']}"; desc="${desc#\"}"; desc="${desc:0:60}"

exec 9>"$file.lock"; flock -w 5 9 || exit 0
[[ -f "$file" ]] || exit 0
src=$(jq -r '.title_source // empty' "$file")
# si mientras tanto el usuario puso nombre, manda el usuario
[[ "$src" == "name" || "$src" == "user" ]] && exit 0
jq --arg t "$project/$type: $desc" --arg ty "$type" \
   '.title=$t | .title_source="model" | .title_pending=0
    | .type=(if .type_source=="name" or .type_source=="user" then .type else $ty end)
    | .type_source=(if .type_source=="name" or .type_source=="user" then .type_source else "model" end)' \
   "$file" > "$file.tmp" && mv "$file.tmp" "$file"
flock -u 9
"$HOME/.local/bin/agent-event" apply-title "$file"
exit 0
