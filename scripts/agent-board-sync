#!/usr/bin/env bash
# agent-board-sync — reconciles airboss state with reality:
#   - Claude: `claude agents --json` is the authoritative source for state, name and pid;
#     creates entries for sessions opened before the hooks existed.
#   - Codex: locates the pid by cwd among live `codex` processes.
#   - Marks `done` the sessions whose process no longer exists.
# Run every 5s by a systemd --user timer (Linux) or a launchd agent (macOS),
# and by the TUI itself.
set -u
_ab_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
for _c in "$_ab_dir/lib-airboss.sh" "$HOME/.local/bin/lib-airboss.sh"; do
  [ -r "$_c" ] && { . "$_c"; break; }
done
command -v ab_lock >/dev/null 2>&1 || { echo "airboss: lib-airboss.sh not found" >&2; exit 1; }
ab_setlocale
# --loop [seconds]: reconcile forever instead of once. launchd refuses to respawn
# a job more than once every 10 s, so a 5 s StartInterval silently becomes 10 s;
# one long-lived process that sleeps between passes is the way to get the real
# cadence there. systemd's timer has no such floor and calls the script directly.
if [[ "${1:-}" == "--loop" ]]; then
  interval="${2:-5}"
  while :; do
    "$0" || true
    sleep "$interval"
  done
fi

STATE_DIR="${AGENT_BOARD_DIR:-$HOME/.local/state/agent-board}"
SESS_DIR="$STATE_DIR/sessions"
mkdir -p "$SESS_DIR"
# only one sync at a time: the timer and the TUI can overlap and clobber files
ab_trylock "$STATE_DIR/sync" || exit 0
trap 'ab_unlock "$STATE_DIR/sync"' EXIT
TMP=".tmp.$$"
now=$(date +%s)
CLAUDE_BIN=$(command -v claude 2>/dev/null || ls -1 "$HOME"/.local/share/mise/installs/claude/*/claude 2>/dev/null | tail -1)

agents='[]'
if [[ -n "${CLAUDE_BIN:-}" ]]; then
  agents=$(ab_timeout 5 "$CLAUDE_BIN" agents --json 2>/dev/null) || agents='[]'
  jq -e 'type=="array"' >/dev/null 2>&1 <<<"$agents" || agents='[]'
fi

# pid → tmux target (#S:#I.#P) for processes that live in a pane
PANE_TABLE=""
if tmux info >/dev/null 2>&1; then
  PANE_TABLE=$(tmux list-panes -a -F $'#{pane_pid}\t#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)
fi
pane_of() { printf '%s\n' "$PANE_TABLE" | awk -F'\t' -v p="$1" '$1==p {print $2; exit}'; }
pane_for_pid() { # walk up the parents until the pane's pid is found
  local p="$1" i hit
  [[ -z "$PANE_TABLE" ]] && return
  for i in 1 2 3 4 5 6; do
    [[ -z "$p" || "$p" == 1 ]] && break
    hit=$(pane_of "$p")
    [[ -n "$hit" ]] && { printf '%s' "$hit"; return; }
    p=$(ab_ppid "$p")
  done
}

# ── Claude: live sessions per the CLI itself ────────────────────────────────
while IFS= read -r row; do
  [[ -z "$row" ]] && continue
  sid=$(jq -r '.sessionId // empty' <<<"$row"); [[ -z "$sid" ]] && continue
  pid=$(jq -r '.pid // empty' <<<"$row"); st=$(jq -r '.status // empty' <<<"$row")
  name=$(jq -r '.name // empty' <<<"$row"); cwd=$(jq -r '.cwd // empty' <<<"$row"); kind=$(jq -r '.kind // "interactive"' <<<"$row")
  # internal plugin sessions (claude-mem observer) aren't yours: skip
  [[ "$cwd" == *"/.claude-mem/"* ]] && continue
  case "$st" in busy) state=working ;; waiting) state=waiting ;; idle) state=idle ;; *) state="" ;; esac
  file="$SESS_DIR/claude-$sid.json"
  if [[ -f "$file" ]]; then
    old=$(cat "$file")
  else
    # session predating the hooks: minimal entry
    if [[ "$cwd" == "$HOME" ]]; then project="home"; else root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); project=$(basename "${root:-$cwd}"); fi
    type="impl"; tsrc="auto"
    [[ "$name" =~ ^[a-zA-Z0-9_.-]+/(impl|plan|fix|review|ops|doc)(:|[[:space:]]|$) ]] && { type="${BASH_REMATCH[1]}"; tsrc="name"; }
    old=$(jq -n --arg sid "$sid" --arg name "$name" --arg project "$project" --arg cwd "$cwd" --arg type "$type" --arg tsrc "$tsrc" --argjson now "$now" \
      '{agent:"claude", session_id:$sid, name:$name, project:$project, cwd:$cwd, type:$type, type_source:$tsrc, goal:"", last_message:"", subagents:0, turns:0, started:$now, source:"sync"}')
  fi
  target=""; [[ -n "$pid" ]] && target=$(pane_for_pid "$pid")
  hook_state=$(jq -r '.state // empty' <<<"$old"); hook_wf=$(jq -r '.waiting_for // empty' <<<"$old")
  # the hook is more precise when it says "waiting" and the CLI doesn't yet reflect it; otherwise the CLI wins
  final="$state"; wf="$hook_wf"
  [[ -z "$final" ]] && final="${hook_state:-idle}"
  [[ "$hook_state" == "waiting" && "$state" == "busy" ]] && final="waiting"
  [[ "$final" != "waiting" ]] && wf=""
  jq --arg name "$name" --arg st "$final" --arg wf "$wf" --arg kind "$kind" --arg tt "$target" --argjson pid "${pid:-null}" --argjson now "$now" \
     '.name = (if $name != "" then $name else .name end) | .state=$st | .waiting_for=(if $wf=="" then null else $wf end)
      | .kind=$kind | .pid=$pid | .tmux_target=(if $tt != "" then $tt else .tmux_target end) | .synced=$now' <<<"$old" > "$file$TMP" && mv "$file$TMP" "$file"
done < <(jq -c '.[]' <<<"$agents" 2>/dev/null)

# ── entries without a title (created by sync): goal from the transcript, then title ──
for f in "$SESS_DIR"/claude-*.json; do
  [[ -f "$f" ]] || continue
  if [[ "$(jq -r '.bootstrapped // 0' "$f")" != "1" && "$(jq -r '.title // empty' "$f")" == "" ]]; then
    "$HOME/.local/bin/agent-event" bootstrap "$f"
  fi
done

# ── Codex: pid by cwd of live processes ─────────────────────────────────────
CODEX_CWD_TABLE=""
while read -r cpid; do
  [[ -z "$cpid" ]] && continue
  c=$(ab_cwd_of_pid "$cpid"); [[ -n "$c" ]] && CODEX_CWD_TABLE="$CODEX_CWD_TABLE$c\t$cpid"$'\n'
done < <(ab_pids_of codex)
codex_pid_for_cwd() { printf '%s' "$CODEX_CWD_TABLE" | awk -F'\t' -v c="$1" '$1==c {print $2; exit}'; }

# ── Codex: entries for live processes without one (sessions predating hooks.json,
#    which never fire hooks). The rollout file the process holds open gives the id. ──
while read -r cpid; do
  roll=$(ab_files_of_pid "$cpid" | grep -o '[^ ]*/\.codex/sessions/[^ ]*rollout-[^ ]*\.jsonl' | head -1)
  [[ -z "$roll" ]] && continue
  sid=$(basename "$roll" .jsonl); sid="${sid: -36}"
  file="$SESS_DIR/codex-$sid.json"
  if ! jq -e . "$file" >/dev/null 2>&1; then
    cwd=$(ab_cwd_of_pid "$cpid")
    name=$(jq -r --arg s "$sid" 'select(.id==$s) | .thread_name // empty' "$HOME/.codex/session_index.jsonl" 2>/dev/null | tail -1)
    if [[ "$cwd" == "$HOME" ]]; then project="home"; else root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); project=$(basename "${root:-$cwd}"); fi
    type="impl"; tsrc="auto"; title=""; title_src=""
    if [[ "$name" =~ ^([a-zA-Z0-9_.-]+)/(impl|plan|fix|review|ops|doc):\ *(.+)$ ]]; then
      project="${BASH_REMATCH[1]}"; type="${BASH_REMATCH[2]}"; tsrc="name"; title="$name"; title_src="name"
    elif [[ "$name" =~ ^([a-zA-Z0-9_.-]+)/(.+)$ ]]; then
      project="${BASH_REMATCH[1]}"; title="$project/$type: ${BASH_REMATCH[2]}"; title_src="user"
    elif [[ -n "$name" ]]; then
      title="$project/$type: $name"; title_src="user"
    fi
    goal=$(grep -m5 '"role":"user"' "$roll" 2>/dev/null | jq -r '(.payload.content // []) | map(select(.type=="input_text" or .type=="text") | .text) | join(" ")' 2>/dev/null \
      | sed 's/^[[:space:]]*//' | grep -v -E '^(<|$)' | head -1 | tr -s '[:space:]' ' ' | cut -c1-240)
    started=$(ab_stat_btime "$roll")
    jq -n --arg sid "$sid" --arg name "$name" --arg title "$title" --arg tsrc "$title_src" --arg project "$project" --arg cwd "$cwd" \
       --arg type "$type" --arg tysrc "$tsrc" --arg goal "$goal" --arg tp "$roll" --argjson pid "$cpid" --argjson started "$started" \
      '{agent:"codex", session_id:$sid, name:$name, title:$title, title_source:$tsrc, project:$project, cwd:$cwd, type:$type, type_source:$tysrc,
        goal:$goal, last_message:"", transcript_path:$tp, subagents:0, turns:0, started:$started, state:"idle", kind:"interactive", pid:$pid,
        source:"sync", hookless:1, bootstrapped:1}' > "$file$TMP" && mv "$file$TMP" "$file"
  fi
  # state from the rollout, like `claude agents` for Claude: an open turn
  # (last task_started with no task_complete) is "working" even if it hasn't
  # written for minutes; "waiting" is set by the permission hook and honored for
  # the rest of the turn. Incremental read: only what was appended since the last
  # pass (the rollout can grow to hundreds of MB in long sessions); the first
  # pass reads it in full.
  size=$(ab_stat_size "$roll")
  read -r off lastev cur < <(jq -r '"\(.roll_off // 0) \(.roll_last // "-") \(.state // "-")"' "$file")
  (( off > size )) && off=0
  if (( size > off )); then
    ev=$(tail -c +$((off+1)) "$roll" 2>/dev/null | grep -o '"type":"task_\(started\|complete\)"' | tail -1)
    [[ -n "$ev" ]] && lastev="$ev"
  fi
  st=idle; [[ "$lastev" == *task_started* ]] && st=working
  [[ "$cur" == "waiting" && "$st" == "working" ]] && st=waiting
  mt=$(ab_stat_mtime "$roll")
  jq --arg st "$st" --arg le "$lastev" --argjson off "$size" --argjson mt "$mt" --argjson pid "$cpid" --argjson now "$now" \
     '.state=$st | .waiting_for=(if $st=="waiting" then .waiting_for else null end) | .updated=$mt | .pid=$pid | .synced=$now
      | .roll_off=$off | .roll_last=$le' "$file" > "$file$TMP" && mv "$file$TMP" "$file"
done < <(ab_pids_of codex)

# ── Sessions whose process no longer exists → done ─────────────────────────
live_ids=$(jq -r '.[].sessionId' <<<"$agents" 2>/dev/null)
for f in "$SESS_DIR"/*.json; do
  [[ -f "$f" ]] && jq -e . "$f" >/dev/null 2>&1 || continue
  agent=$(jq -r '.agent' "$f"); sid=$(jq -r '.session_id' "$f"); st=$(jq -r '.state // ""' "$f")
  [[ "$st" == "done" ]] && continue
  if [[ "$agent" == "claude" ]]; then
    grep -qx -- "$sid" <<<"$live_ids" && continue
    upd=$(jq -r '.updated // .started // 0' "$f")
    # 20s grace period: a session just created by a hook may not be in the list yet
    (( now - upd < 20 )) && continue
    jq --argjson now "$now" '.state="done" | .waiting_for=null | .synced=$now' "$f" > "$f$TMP" && mv "$f$TMP" "$f"
  else
    cwd=$(jq -r '.cwd // "-"' "$f"); [[ -z "$cwd" ]] && cwd="-"; pid=$(codex_pid_for_cwd "$cwd")
    if [[ -n "$pid" ]]; then
      target=$(pane_for_pid "$pid")
      jq --argjson pid "$pid" --arg tt "$target" --argjson now "$now" '.pid=$pid | .tmux_target=(if $tt != "" then $tt else .tmux_target end) | .synced=$now' "$f" > "$f$TMP" && mv "$f$TMP" "$f"
    else
      upd=$(jq -r '.updated // .started // 0' "$f")
      (( now - upd < 20 )) && continue
      jq --argjson now "$now" '.state="done" | .waiting_for=null | .synced=$now' "$f" > "$f$TMP" && mv "$f$TMP" "$f"
    fi
  fi
done

# ── Summary for starship / tmux ─────────────────────────────────────────────
jq -s '{total: (map(select(.state!="done"))|length), waiting: (map(select(.state=="waiting"))|length),
        working: (map(select(.state=="working"))|length), ts: now|floor}' "$SESS_DIR"/*.json 2>/dev/null > "$STATE_DIR/summary.json.tmp" \
  && mv "$STATE_DIR/summary.json.tmp" "$STATE_DIR/summary.json"
exit 0
